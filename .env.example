# ---------------------------------------------------------------
# Application — in production: APP_ENV=production, APP_DEBUG=false,
# APP_URL=https://your-domain, and generate APP_KEY with `php artisan key:generate`.
# ---------------------------------------------------------------
APP_NAME="بيت المونة"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Hebron
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bait_almona
DB_USERNAME=bait_almona
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production (HTTPS-only cookies). Set explicitly if needed.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Database queue is enough to start. Run a worker in production (see docs/PRODUCTION_CHECKLIST.md).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# بيت المونة — حساب المدير الأول (يُستخدم فقط عند تشغيل الـ Seeders)
# اتركها فارغة في الإنتاج وأنشئ المدير عبر: php artisan store:create-admin
# ---------------------------------------------------------------
SEED_ADMIN_NAME="مدير المتجر"
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# زرع البيانات التجريبية (قسم + منتج + عرض + زبون تجريبي)
SEED_DEMO_DATA=true

# ---------------------------------------------------------------
# Customer messaging & one-time codes — NOT integrated yet.
# Leave empty. "log" is a development-only driver that writes to the log.
# Real providers (WhatsApp Business, SMS gateway) will add their own keys
# here later; never commit real credentials.
# ---------------------------------------------------------------
WHATSAPP_PROVIDER=
SMS_PROVIDER=
PUSH_PROVIDER=
CUSTOMER_EMAIL_NOTIFICATIONS=false
MESSAGING_QUEUE=notifications
OTP_DRIVER=

# Require a verified phone (OTP) before checkout. Enforced only when this is
# true AND OTP_DRIVER points to a real sender.
REQUIRE_PHONE_VERIFICATION=false

# ---------------------------------------------------------------
# Payments — only cash on delivery exists today (config/payments.php).
# Online gateways will add PAYMENT_<NAME>_ENABLED + their keys here later.
# ---------------------------------------------------------------
PAYMENT_COD_ENABLED=true

# Version shown on /admin/system (scripts/deploy.sh writes the git commit to
# the VERSION file automatically; set this only to override it).
APP_VERSION=

# Directory where the server's backup job stores database dumps (outside
# public/). Used only by: php artisan store:backup-status
BACKUP_PATH=
